{
  "name": "@indec/react-commons",
  "version": "7.1.0",
  "description": "Common reactjs components for apps",
  "private": false,
  "main": "index.js",
  "exports": {
    "./components": "./components/index.js",
    "./Icons": "./components/Icons/index.js",
    "./hooks": "./hooks/index.js",
    "./utils": "./utils/index.js",
    "./assets": "./assets/index.js"
  },
  "scripts": {
    "start": "start-storybook -p 6006",
    "build": "npm run build:css && NODE_ENV=production babel src --out-dir lib && cp package.json README.md LICENSE.md lib/ && cp src/components/output.css lib/components/ && cp -r src/assets lib/ && find lib -name '*.js' -exec sed -i \"s/\\.jsx'/\\.js'/g\" {} + && find lib -name '*.js' -exec sed -i 's/\\.jsx\"/\\.js\"/g' {} +",
    "build-storybook": "storybook build",
    "test": "jest --config=jest.config.json",
    "test:watch": "jest --config=jest.config.json --watch",
    "eslint": "eslint ./src",
    "validate": "npm run test && npm run eslint",
    "prepare": "husky install",
    "prettier": "prettier src/ --write",
    "build:css": "postcss ./src/styles.css -o ./src/components/output.css",
    "watch:css": "postcss ./src/styles.css -o ./src/components/output.css --watch",
    "storybook": "storybook dev -p 6006"
  },
  "files": [
    "components",
    "hooks",
    "utils",
    "assets",
    "schemas",
    "index.js",
    "LICENSE.md",
    "README.md",
    "!**/*.test.js",
    "!**/*.stories.js",
    "!__tests__",
    "!stories"
  ],
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "formik": "^2.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.0",
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@chromatic-com/storybook": "^3.2.6",
    "@commitlint/cli": "^19.8.0",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-onboarding": "^8.6.12",
    "@storybook/blocks": "^8.6.12",
    "@storybook/experimental-addon-test": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitest/browser": "^3.1.1",
    "@vitest/coverage-v8": "^3.1.1",
    "babel-jest": "^29.4.1",
    "babel-loader": "^9.1.2",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-plugin-transform-imports": "^2.0.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-storybook": "^0.12.0",
    "globals": "^16.0.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "playwright": "^1.51.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.6.2",
    "storybook": "^8.6.12",
    "tailwindcss": "^4.1.11",
    "vitest": "^3.1.1"
  },
  "keywords": [
    "react",
    "components",
    "tailwind",
    "jest",
    "node",
    "storybook"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/indec-it/react-commons.git"
  },
  "bugs": {
    "url": "https://github.com/indec-it/react-commons/issues"
  },
  "homepage": "https://github.com/indec-it/react-commons",
  "author": "INDEC (https://github.com/indec-it)",
  "license": "MIT",
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
